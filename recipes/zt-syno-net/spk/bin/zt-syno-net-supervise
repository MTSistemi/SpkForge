#!/bin/sh
# zt-syno-net — supervisor, runs as the package user (no root).
# Keeps zerotier-one running: restarts it when it exits (backoff 1 s .. 60 s,
# reset after 5 minutes of stable running) and when it stops answering on its
# local API for three checks in a row. Stopped by start-stop-status (SIGTERM).

. "/var/packages/zt-syno-net/target/bin/zt-syno-net-env"
SUP_PID="${HOME_DIR}/supervisor.pid"
LOG_FILE="${HOME_DIR}/zt-syno-net.log"
CHECK_EVERY=4          # health check every 4 x 15 s = 1 minute
MAX_MISSES=3

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${LOG_FILE}"
    if [ "$(wc -l < "${LOG_FILE}")" -gt 1000 ]; then
        tail -n 600 "${LOG_FILE}" > "${LOG_FILE}.tmp" && mv -f "${LOG_FILE}.tmp" "${LOG_FILE}"
    fi
}

child=""
stop_child() {
    if [ -n "${child}" ] && kill -0 "${child}" 2>/dev/null; then
        kill "${child}" 2>/dev/null
        i=0
        while [ $i -lt 20 ] && kill -0 "${child}" 2>/dev/null; do sleep 0.5; i=$((i + 1)); done
        kill -9 "${child}" 2>/dev/null
    fi
}
trap 'stop_child; rm -f "${SUP_PID}"; log "supervisor stopped"; exit 0' TERM INT

echo $$ > "${SUP_PID}"
log "supervisor started (pid $$)"
backoff=1
while :; do
    "${DAEMON}" -U "${HOME_DIR}" >> "${LOG_FILE}" 2>&1 &
    child=$!
    started=$(date +%s)
    log "zerotier-one started (pid ${child})"
    ticks=0
    misses=0
    while kill -0 "${child}" 2>/dev/null; do
        sleep 15 &
        wait $!
        ticks=$((ticks + 1))
        if [ $((ticks % CHECK_EVERY)) -eq 0 ]; then
            if timeout 10 "${DAEMON}" -q "-D${HOME_DIR}" info >/dev/null 2>&1; then
                misses=0
            else
                misses=$((misses + 1))
                log "zerotier-one did not answer (${misses}/${MAX_MISSES})"
                if [ ${misses} -ge ${MAX_MISSES} ]; then
                    log "zerotier-one is not responding, restarting it"
                    stop_child
                fi
            fi
        fi
    done
    wait "${child}" 2>/dev/null
    code=$?
    if [ $(( $(date +%s) - started )) -gt 300 ]; then backoff=1; fi
    log "zerotier-one exited (code ${code}), restarting in ${backoff} s"
    sleep "${backoff}" &
    wait $!
    backoff=$((backoff * 2))
    [ ${backoff} -gt 60 ] && backoff=60
done
