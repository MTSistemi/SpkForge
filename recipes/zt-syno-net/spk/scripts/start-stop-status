#!/bin/sh
# zt-syno-net — DSM 7 start/stop/status control script.
# Runs as the package user (conf/privilege: run-as package), never as root.
# zerotier-one runs under bin/zt-syno-net-supervise, which restarts it if it
# stops. The rights it needs (CAP_NET_ADMIN, /dev/net/tun) come from the root
# guard started by the "zt-syno-net" boot-up task, created by the install
# wizard; DSM 7 gives third-party packages no other way to get them.

. "/var/packages/zt-syno-net/target/bin/zt-syno-net-env"
SUPERVISOR="${TARGET}/bin/zt-syno-net-supervise"
SUP_PID="${HOME_DIR}/supervisor.pid"
LOG_FILE="${HOME_DIR}/zt-syno-net.log"
# Written by the root guard (root-owned, in /run): the identity of the binary
# it granted the capability to. /bin/getcap is root-only on DSM, so this is
# how the package user knows; after an install or upgrade it no longer matches
# until the guard has done its job (within 30 seconds), so start waits for it.
CAPS_MARK="/run/zt-syno-net.caps"
GUARD_PID="/run/zt-syno-net-guard.pid"
# Written by the guard while the identity of an older ZeroTier package is
# still to be moved here. Starting before that would make zerotier-one create
# a new identity: the node would come up under an address its networks do not
# know, and the migration would never happen.
MIGRATING="/run/zt-syno-net.migrating"
START_LOCK="${HOME_DIR}/start.lock"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${LOG_FILE}"
}

# Log the error and hand it to Package Center, which shows the content of
# SYNOPKG_TEMP_LOGFILE when start fails (without it DSM shows a script error).
fail() {
    log "ERROR: $*"
    [ -n "${SYNOPKG_TEMP_LOGFILE}" ] && echo "$*" >> "${SYNOPKG_TEMP_LOGFILE}"
    return 1
}

caps_ready() {
    [ "$(stat -c '%i:%Y:%s' "${DAEMON}" 2>/dev/null)" = "$(cat "${CAPS_MARK}" 2>/dev/null)" ]
}

# The guard runs as root: kill -0 is not allowed on it, /proc is.
guard_running() {
    pid=$(cat "${GUARD_PID}" 2>/dev/null)
    [ -n "${pid}" ] && [ -d "/proc/${pid}" ]
}

supervisor_running() {
    [ -f "${SUP_PID}" ] || return 1
    pid=$(cat "${SUP_PID}" 2>/dev/null)
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

prerequisites_ok() {
    if [ ! -x "${DAEMON}" ]; then
        fail "No zerotier-one build for this CPU ($(uname -m)) in this package: install the universal package or the one for this CPU."
        return 1
    fi
    # Never let zerotier-one invent a new identity when one exists but cannot be
    # read: the node would come up under a new address, unknown to the network.
    if [ -e "${HOME_DIR}/identity.secret" ] && [ ! -r "${HOME_DIR}/identity.secret" ]; then
        fail "${HOME_DIR}/identity.secret is not readable by $(id -un). The zt-syno-net guard fixes it within 30 seconds: start the package again then."
        return 1
    fi
    if [ ! -c /dev/net/tun ] || [ ! -w /dev/net/tun ]; then
        fail "/dev/net/tun is not ready. Check that the zt-syno-net boot-up task exists in Control Panel > Task Scheduler and run it."
        return 1
    fi
    # After an install or upgrade the guard grants the capability on its next
    # round: wait for it rather than fail the upgrade.
    if ! caps_ready && guard_running; then
        log "waiting for the guard to grant the network capability to ${DAEMON}"
        i=0
        while [ $i -lt 40 ] && ! caps_ready; do sleep 1; i=$((i + 1)); done
    fi
    if ! caps_ready; then
        fail "ZeroTier has no network permission yet. Check that the zt-syno-net boot-up task exists in Control Panel > Task Scheduler and run it."
        return 1
    fi
    if migration_pending; then
        log "waiting for the guard to move over the identity of the previous ZeroTier package"
        i=0
        while [ $i -lt 40 ] && migration_pending; do sleep 1; i=$((i + 1)); done
    fi
    if migration_pending; then
        fail "The identity of the previous ZeroTier package has not been moved over yet, because that ZeroTier is still running. Stop it (or uninstall it: its data is kept), then start this package again."
        return 1
    fi
    return 0
}

migration_pending() {
    [ -e "${MIGRATING}" ] && [ ! -e "${HOME_DIR}/identity.secret" ]
}

case "$1" in
    start)
        supervisor_running && exit 0
        # The guard may start the package while DSM does: one start at a time.
        if ! mkdir "${START_LOCK}" 2>/dev/null; then
            # A lock older than two minutes is from a start that died.
            if [ -n "$(find "${START_LOCK}" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then
                rmdir "${START_LOCK}" 2>/dev/null; mkdir "${START_LOCK}" 2>/dev/null || exit 1
            else
                i=0
                while [ $i -lt 60 ] && [ -d "${START_LOCK}" ]; do sleep 1; i=$((i + 1)); done
                supervisor_running && exit 0
                fail "Another start of ZeroTier did not finish. Try again."
                exit 1
            fi
        fi
        trap 'rmdir "${START_LOCK}" 2>/dev/null' EXIT
        prerequisites_ok || exit 1
        # A zerotier-one left behind by a supervisor that died hard would hold
        # the port: stop it first.
        orphan=$(cat "${HOME_DIR}/zerotier-one.pid" 2>/dev/null)
        if [ -n "${orphan}" ] && kill -0 "${orphan}" 2>/dev/null; then
            log "stopping leftover zerotier-one (pid ${orphan})"
            kill "${orphan}" 2>/dev/null
            i=0
            while [ $i -lt 20 ] && kill -0 "${orphan}" 2>/dev/null; do sleep 0.5; i=$((i + 1)); done
            kill -9 "${orphan}" 2>/dev/null
        fi
        setsid /bin/sh "${SUPERVISOR}" </dev/null >/dev/null 2>&1 &
        i=0
        while [ $i -lt 30 ]; do
            if supervisor_running && [ -s "${HOME_DIR}/zerotier-one.port" ]; then exit 0; fi
            sleep 0.5
            i=$((i + 1))
        done
        supervisor_running && exit 0
        fail "ZeroTier did not start: see ${LOG_FILE}."
        exit 1
        ;;
    stop)
        if supervisor_running; then
            pid=$(cat "${SUP_PID}")
            kill "${pid}" 2>/dev/null
            i=0
            while [ $i -lt 30 ] && kill -0 "${pid}" 2>/dev/null; do sleep 0.5; i=$((i + 1)); done
            kill -9 "${pid}" 2>/dev/null
        fi
        rm -f "${SUP_PID}"
        # Leftover daemon, if the supervisor died hard.
        zt_pid=$(cat "${HOME_DIR}/zerotier-one.pid" 2>/dev/null)
        [ -n "${zt_pid}" ] && kill "${zt_pid}" 2>/dev/null
        exit 0
        ;;
    status)
        supervisor_running && exit 0
        exit 3
        ;;
    log)
        echo "${LOG_FILE}"
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
