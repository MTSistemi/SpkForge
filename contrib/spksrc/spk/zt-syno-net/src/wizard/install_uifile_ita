  {
    "step_title": "Avvio automatico e guardia",
    "invalid_next_disabled_v2": false,
    "items": [
      {
        "desc": "DSM 7 non permette ai pacchetti di terze parti di girare come root, e ZeroTier ha bisogno di un permesso di rete. zt-syno-net lo risolve senza altri pacchetti: crea una sola attività all'avvio, eseguita da root, che prepara il sistema, dà a ZeroTier il permesso dopo ogni installazione o aggiornamento e fa ripartire il servizio se si ferma. DSM chiede la tua password per creare un'attività che gira come root."
      },
      {
        "type": "multiselect",
        "subitems": [
          {
            "key": "zt_create_task",
            "desc": "Crea adesso l'attività all'avvio (consigliato)",
            "defaultValue": true
          }
        ]
      },
      {
        "type": "password",
        "subitems": [
          {
            "key": "zt_admin_password",
            "desc": "La tua password di DSM",
            "defaultValue": "",
            "validator": {
              "allowBlank": true
            }
          }
        ]
      },
      {
        "desc": "<b>Configurazione manuale, solo se togli la spunta</b><br>Pannello di controllo > Utilità di pianificazione > Crea > Attività attivata > Script definito dall'utente. Utente: root. Evento: Avvio.<br>Comando da eseguire: /bin/sh /var/packages/zt-syno-net/target/bin/zt-syno-net-guard<br>Salva, seleziona l'attività, Esegui."
      }
    ],
    "deactivate_v2": "{\n  var step = arguments[0], wizard = arguments[1], action = arguments[2];\n  var owner = step.owner || wizard;\n  var title = \"Avvio automatico e guardia\";\n  var show = function (text) {\n    try { if (owner.getMsgBox) { owner.getMsgBox().alert(title, text); return; } } catch (ignore) {}\n    window.alert(text);\n  };\n  var idle = function () { try { if (owner.clearStatusBusy) { owner.clearStatusBusy(); } } catch (ignore) {} };\n  try {\n    if (action !== 'next' || step.ztDone) { return true; }\n    var form = step.getForm();\n    var box = form.findField('zt_create_task');\n    var pwField = form.findField('zt_admin_password');\n    if (!box || !box.getValue()) { if (pwField) { pwField.setValue(''); } step.ztDone = true; return true; }\n    var pw = pwField ? pwField.getValue() : '';\n    if (!pw) { show(\"Inserisci la password, oppure togli la spunta per configurarla a mano\"); return false; }\n    pwField.setValue('');\n    var request = function (api, method, version, params, cb) {\n      var call = { api: api, method: method, version: version, params: params, scope: step,\n        callback: function (success, response) {\n          try { cb(success, response); } catch (e) { idle(); show(\"DSM non ha creato l'attività. Togli la spunta e segui i passi manuali qui sotto.\" + ' (' + e + ')'); }\n        } };\n      if (owner.sendWebAPI) { owner.sendWebAPI(call); }\n      else if (step.sendWebAPI) { step.sendWebAPI(call); }\n      else if (window.SYNO && SYNO.API && SYNO.API.Request) { SYNO.API.Request(call); }\n      else { throw new Error('no DSM WebAPI client in this window'); }\n    };\n    var fail = function (text, response) {\n      idle();\n      var code = response && response.code ? ' [' + response.code + ']' : '';\n      show(text + code);\n    };\n    var task = {\"task_name\":\"zt-syno-net\",\"owner\":{\"0\":\"root\"},\"event\":\"bootup\",\"enable\":true,\"depend_on_task\":\"\",\"notify_enable\":false,\"notify_mail\":\"\",\"notify_if_error\":false,\"description\":\"zt-syno-net guard v1\",\"operation_type\":\"script\",\"operation\":\"cat > /run/zt-syno-net-guard.sh <<'ZT_SYNO_NET_GUARD_EOF'\\n#!/bin/sh\\n# zt-syno-net guard v1 (root). Generated by SpkForge, installed by the\\n# \\\"zt-syno-net\\\" boot-up task. https://github.com/MTSistemi/SpkForge\\nPKG=\\\"zt-syno-net\\\"\\nPKG_USER=\\\"sc-zt-syno-net\\\"\\nPKG_DIR=\\\"/var/packages/$PKG\\\"\\nTARGET=\\\"$PKG_DIR/target\\\"\\nHOME_DIR=\\\"$PKG_DIR/var\\\"\\nMARK=\\\"/run/$PKG.caps\\\"\\nLOG=\\\"/var/log/$PKG-guard.log\\\"\\nPIDF=\\\"/run/$PKG-guard.pid\\\"\\nOLD_DIRS=\\\"/var/packages/zerotier/var /volume1/@appdata/zerotier\\\"\\nexport PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/syno/sbin:/usr/syno/bin\\n\\nlog() {\\n    echo \\\"$(date '+%Y-%m-%d %H:%M:%S') $*\\\" >> \\\"$LOG\\\"\\n    if [ \\\"$(wc -l < \\\"$LOG\\\")\\\" -gt 500 ]; then tail -n 300 \\\"$LOG\\\" > \\\"$LOG.tmp\\\" && mv -f \\\"$LOG.tmp\\\" \\\"$LOG\\\"; fi\\n}\\n\\ndaemon_path() {\\n    echo \\\"/var/packages/zt-syno-net/target/bin/zerotier-one\\\"\\n}\\n\\ninstalled() { [ -f \\\"$PKG_DIR/INFO\\\" ] && [ -d \\\"$TARGET/bin\\\" ]; }\\n\\nplain_file() { [ -f \\\"$1\\\" ] && [ ! -L \\\"$1\\\" ]; }\\n\\nensure_tun() {\\n    lsmod | grep -qw tun || insmod /lib/modules/tun.ko 2>/dev/null || modprobe tun 2>/dev/null\\n    if [ ! -c /dev/net/tun ]; then mkdir -p /dev/net && mknod /dev/net/tun c 10 200; fi\\n    chmod 0666 /dev/net/tun 2>/dev/null\\n}\\n\\nensure_caps() {\\n    d=$(daemon_path)\\n    plain_file \\\"$d\\\" || return\\n    sig=$(stat -c '%i:%Y:%s' \\\"$d\\\")\\n    if [ \\\"$(cat \\\"$MARK\\\" 2>/dev/null)\\\" = \\\"$sig\\\" ] && getcap \\\"$d\\\" | grep -q cap_net_admin && [ \\\"$(stat -c %a \\\"$d\\\")\\\" = 700 ]; then return; fi\\n    # File capabilities apply to whoever runs the file: only the package user may.\\n    chmod 0700 \\\"$d\\\"\\n    if setcap cap_net_admin,cap_net_raw=ep \\\"$d\\\" && [ \\\"$(stat -c '%i:%Y:%s' \\\"$d\\\")\\\" = \\\"$sig\\\" ] && plain_file \\\"$d\\\"; then\\n        echo \\\"$sig\\\" > \\\"$MARK\\\" && chmod 0644 \\\"$MARK\\\"\\n        log \\\"capabilities granted to $d\\\"\\n    else\\n        setcap -r \\\"$d\\\" 2>/dev/null\\n        log \\\"could not grant capabilities to $d\\\"\\n    fi\\n}\\n\\nmigrate() {\\n    [ -e \\\"$HOME_DIR/identity.secret\\\" ] && return\\n    g=$(id -gn \\\"$PKG_USER\\\") || return\\n    d=$(daemon_path)\\n    for old in $OLD_DIRS; do\\n        plain_file \\\"$old/identity.secret\\\" || continue\\n        if ps -eo args | grep '[z]erotier-one' | grep -v \\\"^$d\\\" | grep -q .; then\\n            log \\\"migration waits: another zerotier-one is running with an identity\\\"\\n            return\\n        fi\\n        install -o \\\"$PKG_USER\\\" -g \\\"$g\\\" -m 0644 \\\"$old/identity.public\\\" \\\"$HOME_DIR/identity.public\\\"\\n        install -o \\\"$PKG_USER\\\" -g \\\"$g\\\" -m 0600 \\\"$old/identity.secret\\\" \\\"$HOME_DIR/identity.secret\\\"\\n        plain_file \\\"$old/local.conf\\\" && install -o \\\"$PKG_USER\\\" -g \\\"$g\\\" -m 0644 \\\"$old/local.conf\\\" \\\"$HOME_DIR/local.conf\\\"\\n        for sub in networks.d moons.d; do\\n            [ -d \\\"$old/$sub\\\" ] || continue\\n            install -d -o \\\"$PKG_USER\\\" -g \\\"$g\\\" -m 0755 \\\"$HOME_DIR/$sub\\\"\\n            for f in \\\"$old/$sub\\\"/*; do\\n                plain_file \\\"$f\\\" && install -o \\\"$PKG_USER\\\" -g \\\"$g\\\" -m 0644 \\\"$f\\\" \\\"$HOME_DIR/$sub/\\\"\\n            done\\n        done\\n        log \\\"migrated identity $(cut -c1-10 \\\"$HOME_DIR/identity.public\\\") from $old\\\"\\n        return\\n    done\\n}\\n\\nensure_owner() {\\n    uid=$(id -u \\\"$PKG_USER\\\") || return\\n    g=$(id -gn \\\"$PKG_USER\\\")\\n    for f in identity.public identity.secret; do\\n        p=\\\"$HOME_DIR/$f\\\"\\n        if plain_file \\\"$p\\\" && [ \\\"$(stat -c %u \\\"$p\\\")\\\" != \\\"$uid\\\" ]; then\\n            chown -h \\\"$PKG_USER:$g\\\" \\\"$p\\\" && log \\\"owner of $f set to $PKG_USER\\\"\\n        fi\\n    done\\n    plain_file \\\"$HOME_DIR/identity.secret\\\" && chmod 0600 \\\"$HOME_DIR/identity.secret\\\"\\n}\\n\\nLAST_START=0\\nensure_running() {\\n    st=$(synopkg status \\\"$PKG\\\" 2>/dev/null)\\n    case \\\"$st\\\" in *'\\\"status\\\":\\\"running\\\"'*) return ;; esac\\n    [ -f \\\"$PKG_DIR/enabled\\\" ] || echo \\\"$st\\\" | grep -q '\\\"start_failed\\\"' || return\\n    now=$(date +%s)\\n    [ $((now - LAST_START)) -lt 60 ] && return\\n    LAST_START=$now\\n    if synopkg start \\\"$PKG\\\" >/dev/null 2>&1; then log \\\"started $PKG\\\"; else log \\\"start of $PKG failed, see $HOME_DIR/$PKG.log\\\"; fi\\n}\\n\\nif [ -f \\\"$PIDF\\\" ] && kill -0 \\\"$(cat \\\"$PIDF\\\")\\\" 2>/dev/null; then exit 0; fi\\necho $$ > \\\"$PIDF\\\"\\nlog \\\"guard v1 started\\\"\\nabsent=0\\nwhile :; do\\n    if installed; then\\n        absent=0\\n        ensure_tun\\n        ensure_caps\\n        migrate\\n        ensure_owner\\n        ensure_running\\n    else\\n        absent=$((absent + 1))\\n        if [ \\\"$absent\\\" -gt 60 ]; then log \\\"$PKG not installed for 30 minutes, guard exits\\\"; rm -f \\\"$PIDF\\\"; exit 0; fi\\n    fi\\n    sleep 30\\ndone\\nZT_SYNO_NET_GUARD_EOF\\nchmod 0700 /run/zt-syno-net-guard.sh\\nsetsid /bin/sh /run/zt-syno-net-guard.sh </dev/null >/dev/null 2>&1 &\\nexit 0\"};\n    try { if (owner.setStatusBusy) { owner.setStatusBusy(); } } catch (ignore) {}\n    request('SYNO.Core.User.PasswordConfirm', 'auth', 2, { password: pw }, function (ok, res) {\n      pw = '';\n      if (!ok || !res || !res.SynoConfirmPWToken) { fail(\"DSM non ha accettato la password\", res); return; }\n      task.SynoConfirmPWToken = res.SynoConfirmPWToken;\n      // DSM answers get/set/run on a task that does not exist with success and no\n      // data, so \"exists\" means \"get returned the task\", and the result is checked\n      // with list at the end instead of trusting the success flags.\n      request('SYNO.Core.EventScheduler', 'get', 1, { task_name: task.task_name }, function (okGet, found) {\n        var exists = !!(okGet && found && found.task_name === task.task_name);\n        if (exists) { task.old_task_name = task.task_name; }\n        request('SYNO.Core.EventScheduler.Root', exists ? 'set' : 'create', 1, task, function (ok2, res2) {\n          if (!ok2) { fail(\"DSM non ha creato l'attività. Togli la spunta e segui i passi manuali qui sotto.\", res2); return; }\n          request('SYNO.Core.EventScheduler', 'list', 1, {}, function (okList, tasks) {\n            var present = false;\n            if (okList && tasks && tasks.length) {\n              for (var i = 0; i < tasks.length; i++) { if (tasks[i].task_name === task.task_name) { present = true; } }\n            }\n            if (!present) { fail(\"DSM non ha creato l'attività. Togli la spunta e segui i passi manuali qui sotto.\", res2); return; }\n            request('SYNO.Core.EventScheduler', 'run', 1, { task_name: task.task_name }, function () {\n              idle();\n              step.ztDone = true;\n              show(\"Attività all'avvio creata e avviata. Premi Avanti per continuare.\");\n            });\n          });\n        });\n      });\n    });\n    return false;\n  } catch (e) {\n    idle();\n    show(\"DSM non ha creato l'attività. Togli la spunta e segui i passi manuali qui sotto.\" + ' (' + e + ')');\n    return false;\n  }\n}"
  }
