[
  {
    "step_title": "ZeroTier network",
    "items": [
      {
        "type": "textfield",
        "desc": "Optional: the 16-character ID of the network to join. You can also join later with zerotier-cli.",
        "subitems": [
          {
            "key": "wizard_network_id",
            "desc": "Network ID",
            "defaultValue": "",
            "validator": {
              "allowBlank": true,
              "regex": {
                "expr": "/^[0-9a-fA-F]{16}$/",
                "errorText": "A network ID is 16 hexadecimal characters"
              }
            }
          }
        ]
      }
    ]
  },
  {
    "step_title": "One-time setup: boot-up task",
    "items": [
      {
        "desc": "DSM 7 does not let third-party packages run as root. zt-syno-net needs no extra package for this: a boot-up task prepares the system and the daemon runs without root."
      },
      {
        "desc": "Control Panel > Task Scheduler > Create > Triggered Task > User-defined script. User: root. Event: Boot-up."
      },
      {
        "desc": "Run command: /bin/sh /var/packages/zt-syno-net/target/bin/zt-syno-net-setup"
      },
      {
        "desc": "Save, select the task and click Run once now. Repeat \"Run\" after every upgrade of this package."
      },
      {
        "desc": "Coming from the old \"zerotier\" package? Uninstall it first: the task moves its identity and networks here, so the node ID stays the same."
      }
    ]
  }
]